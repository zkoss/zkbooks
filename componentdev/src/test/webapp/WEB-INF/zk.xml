<?xml version="1.0" encoding="UTF-8"?>
<!--
	Development-loop settings.

	These make an edit to SimpleLabel.js, a mold or the css.dsp visible on a plain
	browser reload. Without them ZK caches the assembled WPD response and you end up
	debugging a stale copy of your own widget - the single most common time-waster
	when developing a component.

	Do NOT ship these settings in production: they disable caching entirely.
-->
<zk>
	<client-config>
		<!-- serve unminified JS and keep the source readable in devtools -->
		<debug-js>true</debug-js>
	</client-config>
	<library-property>
		<name>org.zkoss.zk.WPD.cache</name>
		<value>false</value>
	</library-property>
	<library-property>
		<name>org.zkoss.zk.WCS.cache</name>
		<value>false</value>
	</library-property>

	<desktop-config>
		<!-- U7's second half: <stylesheet> passes through the theme machinery, so an
		     application can switch it off from zk.xml. HtmlPageRenders.getStyleSheets
		     compares disabled.contains(ss.getHref()) against the RAW declared href
		     (HtmlPageRenders.java:451-458), so this string must match the href in
		     src/test/resources/metainfo/zk/lang-addon.xml BYTE FOR BYTE.
		     It names a fixture stylesheet nothing else declares, so no page any other
		     test reads changes. -->
		<disable-theme-uri>~./labfix/css/labfix-disabled-link.css</disable-theme-uri>
	</desktop-config>
</zk>
