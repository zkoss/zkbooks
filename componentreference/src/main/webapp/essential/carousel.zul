<zk xmlns:n="native">
	<style>
		/* The KPI board below. The theme draws the carousel indicators for a dark surface -
		   the active dot is white with a dark ring, the idle ones are dark with a white ring -
		   so on a white page they read inverted. Giving the board the dark surface a wall
		   monitor actually has puts them back in the right order for free. */
		.kpi-board {
			margin: 12px 0 20px; border-radius: 10px;
			background: linear-gradient(160deg, #1d2733 0%, #121821 100%);
			box-shadow: 0 10px 24px rgba(15, 23, 32, 0.28);
		}
		.kpi-slide {
			display: flex; flex-direction: column; justify-content: center; gap: 12px;
			height: 100%; padding: 0 36px 28px; box-sizing: border-box;
		}
		.kpi-caption {
			font-size: 13px; font-weight: 600; letter-spacing: 0.12em;
			text-transform: uppercase; color: #8aa0bb;
		}
		/* The size has to sit on the label itself: .z-label carries its own font-size, so a
		   size set on this wrapper alone is overridden and never reaches the number. */
		.kpi-value { display: flex; align-items: baseline; gap: 6px; }
		/* tabular-nums keeps the digits from shifting sideways as the value changes */
		.kpi-number {
			font-size: 58px; font-weight: 600; line-height: 1; letter-spacing: -0.02em;
			color: #f2f6fb; font-variant-numeric: tabular-nums;
		}
		.kpi-unit { font-size: 26px; font-weight: 400; color: #8aa0bb; }
		/* one pill shape for the third line of every panel, so neutral, bad and good news
		   read as the same slot instead of three unrelated coloured sentences */
		.kpi-note { align-self: flex-start; font-size: 13px; padding: 4px 12px; border-radius: 999px; }
		.kpi-note-flat { background: rgba(138, 160, 187, 0.16); color: #b6c6da; }
		.kpi-note-good { background: rgba(39, 174, 96, 0.18); color: #6ee7a0; }
		.kpi-note-bad { background: rgba(231, 76, 60, 0.18); color: #ff9d92; }
	</style>
	<n:h1>Basic</n:h1>
	<n:p>
	a carousel of carouselitem slides; onSelect is a SelectEvent whose data carries the new
	index and whose reference is the activated carouselitem
	</n:p>
	<carousel width="600px" height="300px">
		<attribute name="onSelect">
			Clients.showNotification("slide " + event.getData().get("index")
					+ " (" + event.getReference() + ")");
		</attribute>
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
		<carouselitem label="A slide can also hold any markup">
			<vlayout>
				<label value="Custom slide body"/>
				<button label="Action"/>
			</vlayout>
		</carouselitem>
	</carousel>

	<n:h1>Active index</n:h1>
	<n:p>
	activeIndex selects the slide shown first; an out-of-range value is clamped into
	[0, childCount-1]
	</n:p>
	<carousel width="600px" height="300px" activeIndex="1">
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
		<carouselitem image="/multimedia/abcdefg-64x64.png"/>
	</carousel>

	<n:h1>Autoplay</n:h1>
	<n:p>
	autoplay advances every interval ms (minimum 500)
	</n:p>
	<carousel width="600px" height="300px" autoplay="true" interval="2000">
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
	</carousel>

	<n:h1>Pause on hover</n:h1>
	<n:p>
	pause is true by default, so autoplay stops while the pointer rests on the carousel;
	the one below keeps advancing under the cursor
	</n:p>
	<carousel width="600px" height="300px" autoplay="true" interval="1500" pause="false">
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
	</carousel>

	<n:h1>Keyboard</n:h1>
	<n:p>
	keyboard is true by default: with focus on the carousel, the left and right arrow keys
	switch slides. The one below has it turned off.
	</n:p>
	<carousel width="600px" height="300px" keyboard="false">
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
	</carousel>

	<n:h1>Arrows and indicators</n:h1>
	<n:h2>indicators only</n:h2>
	<carousel width="600px" height="300px" showArrows="false">
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
	</carousel>
	<n:h2>arrows only</n:h2>
	<carousel width="600px" height="300px" showIndicators="false">
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
	</carousel>
	<n:h2>neither, driven by autoplay alone</n:h2>
	<carousel width="600px" height="300px" showArrows="false" showIndicators="false"
			  autoplay="true" interval="2000">
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
	</carousel>

	<n:h1>Effect: fade</n:h1>
	<carousel width="600px" height="300px" effect="fade">
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
	</carousel>

	<n:h1>Effect: none</n:h1>
	<n:p>
	an instantaneous swap with no transition
	</n:p>
	<carousel width="600px" height="300px" effect="none">
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
	</carousel>

	<n:h1>Vertical orientation</n:h1>
	<carousel width="600px" height="300px" orient="vertical">
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
	</carousel>

	<n:h1>No loop</n:h1>
	<n:p>
	with loop="false", the prev/next arrows are disabled at the boundaries
	</n:p>
	<carousel width="600px" height="300px" loop="false">
		<carouselitem image="/multimedia/cropper-image.jpg"/>
		<carouselitem image="/multimedia/zklogo3.png"/>
	</carousel>

	<n:h1>onChanging</n:h1>
	<n:p>
	onChanging fires before the slide switches and is delivered as an InputEvent:
	getValue() is the index it is moving to, getPreviousValue() is the index it is leaving.
	Autoplay ticks are not sent to the server, so only arrow, indicator and swipe
	navigation reach the listener below.
	</n:p>
	<carousel id="changingCarousel" width="600px" height="300px">
		<attribute name="onChanging">
			changingLog.setValue("onChanging: leaving " + event.getPreviousValue()
					+ ", going to " + event.getValue());
		</attribute>
		<attribute name="onSelect">
			selectLog.setValue("onSelect: activeIndex is now " + self.getActiveIndex()
					+ ", getSelectedItem() is " + self.getSelectedItem().getLabel());
		</attribute>
		<carouselitem label="First" image="/multimedia/cropper-image.jpg"/>
		<carouselitem label="Second" image="/multimedia/zklogo3.png"/>
		<carouselitem label="Third" image="/multimedia/abcdefg-64x64.png"/>
	</carousel>
	<vlayout>
		<label id="changingLog" value="onChanging: -"/>
		<label id="selectLog" value="onSelect: -"/>
	</vlayout>

	<n:h1>Server-side navigation</n:h1>
	<n:p>
	setActiveIndex drives the carousel from the server; getSelectedItem returns the active
	carouselitem
	</n:p>
	<carousel id="drivenCarousel" width="600px" height="300px">
		<carouselitem label="Q1" image="/multimedia/cropper-image.jpg"/>
		<carouselitem label="Q2" image="/multimedia/zklogo3.png"/>
		<carouselitem label="Q3" image="/multimedia/abcdefg-64x64.png"/>
	</carousel>
	<hlayout>
		<button label="Go to Q1">
			<attribute name="onClick">drivenCarousel.setActiveIndex(0);</attribute>
		</button>
		<button label="Go to Q3">
			<attribute name="onClick">drivenCarousel.setActiveIndex(2);</attribute>
		</button>
		<button label="Which slide is active?">
			<attribute name="onClick">
				Clients.showNotification("active: "
						+ drivenCarousel.getSelectedItem().getLabel()
						+ " (index " + drivenCarousel.getActiveIndex() + ")");
			</attribute>
		</button>
	</hlayout>

	<n:h1>Use Cases</n:h1>

	<n:h2>KPI board on a wall monitor</n:h2>
	an unattended dashboard that rotates through its panels on its own, with no controls to
	click and no pause when someone walks past <n:br/>
	<carousel sclass="kpi-board" width="480px" height="270px" autoplay="true" interval="3000"
			  pause="false" showArrows="false">
		<carouselitem>
			<div sclass="kpi-slide">
				<label sclass="kpi-caption" value="On-time delivery"/>
				<div sclass="kpi-value">
					<label sclass="kpi-number" value="96.4"/><label sclass="kpi-unit" value="%"/>
				</div>
				<label sclass="kpi-note kpi-note-flat" value="target 95 %, week 34"/>
			</div>
		</carouselitem>
		<carouselitem>
			<div sclass="kpi-slide">
				<label sclass="kpi-caption" value="Open service tickets"/>
				<div sclass="kpi-value">
					<label sclass="kpi-number" value="128"/>
				</div>
				<label sclass="kpi-note kpi-note-bad" value="18 breached SLA"/>
			</div>
		</carouselitem>
		<carouselitem>
			<div sclass="kpi-slide">
				<label sclass="kpi-caption" value="Inventory turns"/>
				<div sclass="kpi-value">
					<label sclass="kpi-number" value="7.2"/>
				</div>
				<label sclass="kpi-note kpi-note-good" value="up from 6.8 last quarter"/>
			</div>
		</carouselitem>
	</carousel>

	<n:h2>Asset photo gallery in a detail form</n:h2>
	the photos attached to one equipment record, with the caption of the visible photo kept
	in sync from onSelect
	<vlayout style="border:1px solid #ddd; border-radius:4px; padding:12px; width:620px">
		<label value="Equipment EQ-4410 - Hydraulic press" style="font-weight:bold"/>
		<carousel id="gallery" width="580px" height="260px" effect="fade">
			<attribute name="onSelect">
				galleryCaption.setValue(gallery.getSelectedItem().getLabel());
			</attribute>
			<carouselitem label="Nameplate, 2026-03-11" image="/multimedia/cropper-image.jpg"/>
			<carouselitem label="Hydraulic unit, 2026-03-11" image="/multimedia/zklogo3.png"/>
			<carouselitem label="Control panel, 2026-05-02" image="/multimedia/abcdefg-64x64.png"/>
		</carousel>
		<label id="galleryCaption" value="Nameplate, 2026-03-11" style="color:#666"/>
	</vlayout>

	<n:h2>Release-notes announcement</n:h2>
	a short onboarding sequence shown after a version upgrade; loop is off so the user
	reaches a definite end
	<carousel width="600px" height="200px" loop="false" effect="slide">
		<carouselitem>
			<vlayout style="padding:24px">
				<label value="What is new in release 26.3" style="font-weight:bold; font-size:16px"/>
				<label value="Three changes affect your daily work."/>
			</vlayout>
		</carouselitem>
		<carouselitem>
			<vlayout style="padding:24px">
				<label value="1. Batch posting" style="font-weight:bold; font-size:16px"/>
				<label value="Invoices can now be posted in batches of up to 500."/>
			</vlayout>
		</carouselitem>
		<carouselitem>
			<vlayout style="padding:24px">
				<label value="2. Approval delegation" style="font-weight:bold; font-size:16px"/>
				<label value="Approvers can delegate while out of office."/>
			</vlayout>
		</carouselitem>
	</carousel>

	<n:h2>Guarded step-through of a review queue</n:h2>
	onChanging records the move before it happens, which is where a review workflow would
	check whether the current step may be left
	<vlayout style="border:1px solid #ddd; border-radius:4px; padding:12px; width:620px">
		<carousel id="reviewQueue" width="580px" height="180px" loop="false"
				  showIndicators="true">
			<attribute name="onChanging">
				reviewLog.setValue("moving from document " + event.getPreviousValue()
						+ " to document " + event.getValue());
			</attribute>
			<carouselitem label="INV-88301">
				<vlayout style="padding:16px">
					<label value="INV-88301 - Northwind Traders" style="font-weight:bold"/>
					<label value="USD 12,400, due 2026-09-15"/>
				</vlayout>
			</carouselitem>
			<carouselitem label="INV-88302">
				<vlayout style="padding:16px">
					<label value="INV-88302 - Globex Corp" style="font-weight:bold"/>
					<label value="USD 3,980, due 2026-09-18"/>
				</vlayout>
			</carouselitem>
			<carouselitem label="INV-88303">
				<vlayout style="padding:16px">
					<label value="INV-88303 - Initech" style="font-weight:bold"/>
					<label value="USD 41,150, due 2026-09-20"/>
				</vlayout>
			</carouselitem>
		</carousel>
		<label id="reviewLog" value="moving from document - to document -" style="color:#666"/>
	</vlayout>
</zk>
