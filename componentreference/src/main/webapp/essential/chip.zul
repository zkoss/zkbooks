<zk xmlns:n="native">
	<n:h1>Severity</n:h1>
	<chip label="Info" severity="info"/>
	<chip label="Success" severity="success"/>
	<chip label="Warning" severity="warning"/>
	<chip label="Danger" severity="danger"/>
	<chip label="Secondary" severity="secondary"/>

	<n:h1>Size</n:h1>
	<chip label="Small" size="small"/>
	<chip label="Medium" size="medium"/>

	<n:h1>Rounded</n:h1>
	a pill-shaped chip
	<chip label="Pill" rounded="true"/>

	<n:h1>Disabled</n:h1>
	<chip label="Disabled" disabled="true"/>

	<n:h1>Closable</n:h1>
	the close button fires onClose; the application removes the chip explicitly
	<hlayout>
		<chip label="React" closable="true" onClose="self.detach()"/>
		<chip label="ZK" closable="true" onClose="self.detach()"/>
		<chip label="Java" closable="true" onClose="self.detach()"/>
	</hlayout>
</zk>
